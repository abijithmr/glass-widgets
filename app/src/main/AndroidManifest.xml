<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the Music widget see whether Apple Music is installed -->
    <queries>
        <package android:name="com.apple.android.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opens when the weather widget is added, and from the library -->
        <activity
            android:name=".WeatherSetupActivity"
            android:exported="true"
            android:label="@string/setup_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Opens when the countdown widget is added, and when it is tapped -->
        <activity
            android:name=".CountdownSetupActivity"
            android:exported="true"
            android:label="@string/countdown_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Runs a Focus tap, then closes. Needs an activity so it can open the access screen. -->
        <activity
            android:name=".FocusActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Analog clock -->
        <receiver
            android:name=".GlassAnalogClockWidget"
            android:exported="true"
            android:label="@string/widget_glass_analog_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_analog_clock_info" />
        </receiver>

        <!-- Digital clock -->
        <receiver
            android:name=".GlassDigitalClockWidget"
            android:exported="true"
            android:label="@string/widget_glass_digital_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_digital_clock_info" />
        </receiver>

        <!-- Weather -->
        <receiver
            android:name=".GlassWeatherWidget"
            android:exported="true"
            android:label="@string/widget_glass_weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_weather_info" />
        </receiver>

        <!-- Week calendar -->
        <receiver
            android:name=".GlassCalendarWeekWidget"
            android:exported="true"
            android:label="@string/widget_glass_calendar_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_calendar_week_info" />
        </receiver>

        <!-- Month calendar -->
        <receiver
            android:name=".GlassCalendarMonthWidget"
            android:exported="true"
            android:label="@string/widget_glass_calendar_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_calendar_month_info" />
        </receiver>

        <!-- Control tiles -->
        <receiver
            android:name=".GlassControlsWidget"
            android:exported="true"
            android:label="@string/widget_glass_controls">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_controls_info" />
        </receiver>

        <!-- Mini clock -->
        <receiver
            android:name=".GlassMiniClockWidget"
            android:exported="true"
            android:label="@string/widget_glass_mini_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_mini_clock_info" />
        </receiver>

        <!-- Countdown -->
        <receiver
            android:name=".GlassCountdownWidget"
            android:exported="true"
            android:label="@string/widget_glass_countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_countdown_info" />
        </receiver>

        <!-- Music player shortcut -->
        <receiver
            android:name=".GlassMusicWidget"
            android:exported="true"
            android:label="@string/widget_glass_music">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_music_info" />
        </receiver>

        <!-- Date tile -->
        <receiver
            android:name=".GlassDateWidget"
            android:exported="true"
            android:label="@string/widget_glass_date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_date_info" />
        </receiver>

        <!-- Weather card -->
        <receiver
            android:name=".GlassWeatherCardWidget"
            android:exported="true"
            android:label="@string/widget_glass_weather_card">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_weather_card_info" />
        </receiver>

        <!-- Focus (Do Not Disturb) -->
        <receiver
            android:name=".GlassFocusWidget"
            android:exported="true"
            android:label="@string/widget_glass_focus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_focus_info" />
        </receiver>

        <!-- Dock -->
        <receiver
            android:name=".GlassDockWidget"
            android:exported="true"
            android:label="@string/widget_glass_dock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_dock_info" />
        </receiver>

        <!-- Search -->
        <receiver
            android:name=".GlassSearchWidget"
            android:exported="true"
            android:label="@string/widget_glass_search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_search_info" />
        </receiver>

        <!-- Battery -->
        <receiver
            android:name=".GlassBatteryWidget"
            android:exported="true"
            android:label="@string/widget_glass_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_battery_info" />
        </receiver>

    </application>

</manifest>
