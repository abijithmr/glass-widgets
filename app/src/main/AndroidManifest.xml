<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- System Monitor refreshes every 5 s while the screen is on -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Brightness tile: set screen brightness (the person allows this once) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Bluetooth pop-up: list paired devices and switch Bluetooth on or off -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Files widget: read folders such as Download and DCIM (Android 11+: "All files access") -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Lets the Music widget see whether a supported music app is installed -->
    <queries>
        <package android:name="com.apple.android.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlassWidgets">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opens when the weather widget is added, and from the library -->
        <activity
            android:name=".WeatherSetupActivity"
            android:exported="true"
            android:label="@string/setup_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Opens when the countdown widget is added, and when it is tapped -->
        <activity
            android:name=".CountdownSetupActivity"
            android:exported="true"
            android:label="@string/countdown_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Sensor readings and source choices for the System Monitor -->
        <activity
            android:name=".SensorsActivity"
            android:exported="false"
            android:label="Sensors" />

        <!-- Bluetooth pop-up opened from the Controls widget -->
        <activity
            android:name=".BluetoothPopupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.GlassPopup" />

        <!-- Cycles brightness low / mid / peak, then closes -->
        <activity
            android:name=".BrightnessActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Runs a Focus tap, then closes. Needs an activity so it can open the access screen. -->
        <activity
            android:name=".FocusActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Files widget: setup (also its configuration screen), folder picker, tap handler -->
        <activity
            android:name=".FilesSetupActivity"
            android:exported="true"
            android:label="Files widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FolderPickerActivity"
            android:exported="false"
            android:label="Pick a folder" />

        <!-- Search pop-up opened from the Files widget -->
        <activity
            android:name=".FilesSearchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.GlassPopup"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Share / rename / copy path / delete pop-up for one item -->
        <activity
            android:name=".FilesItemActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.GlassPopup"
            android:windowSoftInputMode="stateUnchanged|adjustResize" />

        <!-- Opens a folder inside the widget or a file in another app, then closes -->
        <activity
            android:name=".FilesActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Wakes only when Android's file index changes, to refresh the Files widget -->
        <service
            android:name=".FilesRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".FilesGridService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Lets other apps open a file the widget hands them -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files_paths" />
        </provider>

        <!-- Files -->
        <receiver
            android:name=".GlassFilesWidget"
            android:exported="true"
            android:label="@string/widget_glass_files">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_files_info" />
        </receiver>

        <!-- Analog clock -->
        <receiver
            android:name=".GlassAnalogClockWidget"
            android:exported="true"
            android:label="@string/widget_glass_analog_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_analog_clock_info" />
        </receiver>

        <!-- Digital clock -->
        <receiver
            android:name=".GlassDigitalClockWidget"
            android:exported="true"
            android:label="@string/widget_glass_digital_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_digital_clock_info" />
        </receiver>

        <!-- Weather -->
        <receiver
            android:name=".GlassWeatherWidget"
            android:exported="true"
            android:label="@string/widget_glass_weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_weather_info" />
        </receiver>

        <!-- Week calendar -->
        <receiver
            android:name=".GlassCalendarWeekWidget"
            android:exported="true"
            android:label="@string/widget_glass_calendar_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_calendar_week_info" />
        </receiver>

        <!-- Month calendar -->
        <receiver
            android:name=".GlassCalendarMonthWidget"
            android:exported="true"
            android:label="@string/widget_glass_calendar_month">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_calendar_month_info" />
        </receiver>

        <!-- Control tiles -->
        <receiver
            android:name=".GlassControlsWidget"
            android:exported="true"
            android:label="@string/widget_glass_controls">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_controls_info" />
        </receiver>

        <!-- Mini clock -->
        <receiver
            android:name=".GlassMiniClockWidget"
            android:exported="true"
            android:label="@string/widget_glass_mini_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_mini_clock_info" />
        </receiver>

        <!-- Countdown -->
        <receiver
            android:name=".GlassCountdownWidget"
            android:exported="true"
            android:label="@string/widget_glass_countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_countdown_info" />
        </receiver>

        <!-- Music player shortcut -->
        <receiver
            android:name=".GlassMusicWidget"
            android:exported="true"
            android:label="@string/widget_glass_music">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_music_info" />
        </receiver>

        <!-- Date tile -->
        <receiver
            android:name=".GlassDateWidget"
            android:exported="true"
            android:label="@string/widget_glass_date">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_date_info" />
        </receiver>

        <!-- Weather card -->
        <receiver
            android:name=".GlassWeatherCardWidget"
            android:exported="true"
            android:label="@string/widget_glass_weather_card">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_weather_card_info" />
        </receiver>

        <!-- Focus (Do Not Disturb) -->
        <receiver
            android:name=".GlassFocusWidget"
            android:exported="true"
            android:label="@string/widget_glass_focus">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_focus_info" />
        </receiver>

        <!-- Dock -->
        <receiver
            android:name=".GlassDockWidget"
            android:exported="true"
            android:label="@string/widget_glass_dock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_dock_info" />
        </receiver>

        <!-- Search -->
        <receiver
            android:name=".GlassSearchWidget"
            android:exported="true"
            android:label="@string/widget_glass_search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_search_info" />
        </receiver>

        <!-- Battery -->
        <receiver
            android:name=".GlassBatteryWidget"
            android:exported="true"
            android:label="@string/widget_glass_battery">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_battery_info" />
        </receiver>

        <!-- System monitor -->
        <receiver
            android:name=".GlassMonitorWidget"
            android:exported="true"
            android:label="@string/widget_glass_monitor">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_monitor_info" />
        </receiver>

        <!-- Music card and Quick Panel -->
        <receiver
            android:name=".GlassMusicCardWidget"
            android:exported="true"
            android:label="@string/widget_glass_music_card">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_music_card_info" />
        </receiver>

        <receiver
            android:name=".GlassControlCenterWidget"
            android:exported="true"
            android:label="@string/widget_glass_control_center">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_control_center_info" />
        </receiver>

        <!-- Media keys and torch, called from the widgets -->
        <receiver
            android:name=".MediaKeyReceiver"
            android:exported="false" />
        <receiver
            android:name=".TorchReceiver"
            android:exported="false" />

        <!-- Lets the music widgets see the song that is playing (notification access) -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
