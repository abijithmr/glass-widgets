<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassWidgets" parent="@android:style/Theme.DeviceDefault.NoActionBar" />

    <!-- One weekday cell in the digital clock's week strip -->
    <style name="GlassDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#B3FFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>
