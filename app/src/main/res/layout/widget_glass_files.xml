<?xml version="1.0" encoding="utf-8"?>
<!-- Files widget: dark glass window, pinned folders on the left, folder grid on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/files_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left rail: pinned folders -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rail_recent"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.85"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_recent" />

                <TextView
                    android:id="@+id/rail_recent_label"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Recent"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <TextView
                android:id="@+id/rail_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false"
                android:text="Pinned"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <LinearLayout
                android:id="@+id/rail_row_0"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_blue" />

                <TextView
                    android:id="@+id/rail_label_0"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_row_1"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_blue" />

                <TextView
                    android:id="@+id/rail_label_1"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_row_2"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_blue" />

                <TextView
                    android:id="@+id/rail_label_2"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_row_3"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_blue" />

                <TextView
                    android:id="@+id/rail_label_3"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_row_4"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_blue" />

                <TextView
                    android:id="@+id/rail_label_4"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_row_5"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder_blue" />

                <TextView
                    android:id="@+id/rail_label_5"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_search"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:id="@+id/rail_search_label"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Search"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rail_manage"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/files_rail_press"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_add" />

                <TextView
                    android:id="@+id/rail_manage_label"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Pin folder"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:background="#1FFFFFFF" />

        <!-- Right pane: header and the folder grid -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/files_back"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/files_back_bg"
                    android:contentDescription="Back"
                    android:padding="4dp"
                    android:src="@drawable/ic_chevron_left" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/files_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <TextView
                        android:id="@+id/files_sort_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#CCFFFFFF"
                        android:textSize="11sp"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/files_sort"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/files_back_bg"
                    android:contentDescription="Change sort order"
                    android:padding="6dp"
                    android:src="@drawable/ic_sort" />

                <ImageView
                    android:id="@+id/files_select"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/files_back_bg"
                    android:contentDescription="Select an item for actions"
                    android:padding="6dp"
                    android:src="@drawable/ic_select" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <GridView
                    android:id="@+id/files_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:columnWidth="72dp"
                    android:listSelector="@android:color/transparent"
                    android:numColumns="auto_fit"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="4dp" />

                <TextView
                    android:id="@+id/files_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Pinned folders open here"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
