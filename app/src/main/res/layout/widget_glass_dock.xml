<?xml version="1.0" encoding="utf-8"?>
<!-- Pill-shaped dock with five app shortcuts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:weightSum="5">

    <LinearLayout
        android:id="@+id/dock_phone"
        android:contentDescription="@string/a11y_dock_phone"
        style="@style/GlassDockSlot">
        <ImageView
            style="@style/GlassDockIcon"
            android:src="@drawable/ic_phone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_message"
        android:contentDescription="@string/a11y_dock_message"
        style="@style/GlassDockSlot">
        <ImageView
            style="@style/GlassDockIcon"
            android:src="@drawable/ic_message" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_browser"
        android:contentDescription="@string/a11y_dock_browser"
        style="@style/GlassDockSlot">
        <ImageView
            style="@style/GlassDockIcon"
            android:src="@drawable/ic_globe" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_camera"
        android:contentDescription="@string/a11y_dock_camera"
        style="@style/GlassDockSlot">
        <ImageView
            style="@style/GlassDockIcon"
            android:src="@drawable/ic_camera" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_calendar"
        android:contentDescription="@string/a11y_dock_calendar"
        style="@style/GlassDockSlot">
        <ImageView
            style="@style/GlassDockIcon"
            android:src="@drawable/ic_calendar" />
    </LinearLayout>

</LinearLayout>
