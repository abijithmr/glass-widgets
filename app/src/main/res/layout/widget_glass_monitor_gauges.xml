<?xml version="1.0" encoding="utf-8"?>
<!-- System monitor, look A: three gauges and three tiles -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="SYSTEM MONITOR"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp">
                    <ImageView
                        android:id="@+id/mg_ring_cpu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                <TextView
                android:id="@+id/mg_cpu_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                android:id="@+id/mg_cpu_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#C0FFFFFF"
                    android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.1"
                    android:text="CPU"
                    android:textColor="#8FDAFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_cpu_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#D9FFFFFF"
                    android:textSize="9.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp">
                    <ImageView
                        android:id="@+id/mg_ring_ram"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                <TextView
                android:id="@+id/mg_ram_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                android:id="@+id/mg_ram_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#C0FFFFFF"
                    android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.1"
                    android:text="MEMORY"
                    android:textColor="#CDB3FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_ram_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#D9FFFFFF"
                    android:textSize="9.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp">
                    <ImageView
                        android:id="@+id/mg_ring_stor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                <TextView
                android:id="@+id/mg_stor_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />

                <TextView
                android:id="@+id/mg_stor_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#C0FFFFFF"
                    android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.1"
                    android:text="STORAGE"
                    android:textColor="#8FE8E2"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_stor_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#D9FFFFFF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/monitor_chip"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="CPU TEMP"
                    android:textColor="#FFB08F"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_ct_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                android:id="@+id/mg_ct_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#C7FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/monitor_chip"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="BATT TEMP"
                    android:textColor="#FFDB8F"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_bt_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                android:id="@+id/mg_bt_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#C7FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/monitor_chip"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="BATTERY"
                    android:textColor="#A3E8B5"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/mg_ba_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView
                android:id="@+id/mg_ba_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#C7FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
