<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scratch_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/scratch_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFF4F6F9"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/scratch_back"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/scratch_btn_ghost"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Back"
            android:textColor="#FF1D2330"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/scratch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Untitled"
            android:textColor="#FF1D2330"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scratch_share"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/scratch_btn_ghost"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Share"
            android:textColor="#FF1D2330"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/scratch_save"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/scratch_btn_primary"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Save as…"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scratch_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="More"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#FF1D2330"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:id="@+id/scratch_line_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFE1E6EE" />

    <com.glasswidgets.ScratchEditText
        android:id="@+id/scratch_field"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="Start typing…"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingExtra="5dp"
        android:padding="18dp"
        android:textColor="#FF1D2330"
        android:textColorHint="#FF9AA3B5"
        android:textCursorDrawable="@drawable/scratch_cursor"
        android:textSize="15sp" />

    <View
        android:id="@+id/scratch_line_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFE1E6EE" />

    <TextView
        android:id="@+id/scratch_status"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="#FFF4F6F9"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#FF7A849A"
        android:textSize="11.5sp" />
</LinearLayout>
