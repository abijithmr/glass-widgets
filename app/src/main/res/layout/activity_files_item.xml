<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/popup_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/panel_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/act_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/files_rail_press"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:text="Share"
                android:textColor="#F2FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/act_rename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/files_rail_press"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:text="Rename"
                android:textColor="#F2FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/act_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/files_rail_press"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:text="Copy path"
                android:textColor="#F2FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/act_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/files_rail_press"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:text="Delete"
                android:textColor="#FFFF8A80"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Rename -->
        <LinearLayout
            android:id="@+id/panel_rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/rename_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_field_bg"
                android:inputType="text"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/rename_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/files_back_bg"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Cancel"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/rename_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/files_back_bg"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Save"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Delete confirmation -->
        <LinearLayout
            android:id="@+id/panel_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/delete_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/delete_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/files_back_bg"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Cancel"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/delete_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/files_danger_bg"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Delete"
                android:textColor="#FFFFC9C4"
                android:textSize="15sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
