<?xml version="1.0" encoding="utf-8"?>
<!-- System monitor, look F: neofetch -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/monitor_terminal_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nf_logo"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="glass@phone"
                    android:textColor="#6FD38B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#8CFFFFFF"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/nf_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="3dp"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="#8CFFFFFF"
                    android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="OS"
                    android:textColor="#8FDAFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="Device"
                    android:textColor="#8FDAFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="SoC"
                    android:textColor="#8FDAFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="CPU"
                    android:textColor="#8FDAFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="Temp"
                    android:textColor="#FF8A5B"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="Memory"
                    android:textColor="#B48CFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="Disk"
                    android:textColor="#4DD0C8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="monospace"
                    android:text="Battery"
                    android:textColor="#6FD38B"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nf_v8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#E8EEF5"
                    android:textSize="10.5sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="#5CC8FF" />
                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="#FF8A5B" />
                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="#B48CFF" />
                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="#4DD0C8" />
                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="#6FD38B" />
                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="3dp"
                    android:background="#FFC857" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
