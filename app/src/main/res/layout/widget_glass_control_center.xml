<?xml version="1.0" encoding="utf-8"?>
<!-- Control centre: Focus pill, torch and airplane circles, and a music card underneath -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cc_focus"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/glass_tile"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:id="@+id/cc_moon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/glass_tile"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/cc_moon_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_moon" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Focus"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/cc_focus_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#B3FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cc_torch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/glass_tile"
                android:contentDescription="@string/a11y_torch"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/cc_torch_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_torch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cc_airplane"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/glass_tile"
                android:contentDescription="@string/a11y_airplane"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/cc_airplane_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_airplane" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cc_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/glass_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/cc_open"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/cc_art_box"
                android:layout_width="44dp"
                android:layout_height="44dp">

                <LinearLayout
                    android:id="@+id/cc_art"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_tile"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_music_note" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/cc_art_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cc_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Music"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/cc_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/cc_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/battery_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/cc_prev"
                android:contentDescription="@string/a11y_music_prev"
                style="@style/GlassDockSlot">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_prev" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cc_play"
                android:contentDescription="@string/a11y_music_play"
                style="@style/GlassDockSlot">
                <ImageView
                    android:id="@+id/cc_play_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cc_next"
                android:contentDescription="@string/a11y_music_next"
                style="@style/GlassDockSlot">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
