<?xml version="1.0" encoding="utf-8"?>
<!-- Scratchpad widget: a plain white page with a header and a footer strip -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scratch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/scratch_card_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/scratch_header"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/scratch_top_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/scratch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="Scratchpad"
            android:textColor="#FF1D2330"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scratch_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#FF7A849A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/scratch_text_0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="13.5sp"
        android:visibility="visible" />

    <TextView
        android:id="@+id/scratch_text_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scratch_text_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/jetbrains_mono"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scratch_text_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/atkinson_hyperlegible"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scratch_text_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/lora"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scratch_text_5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/special_elite"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scratch_text_6"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/caveat"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text=""
        android:textColor="#FF1D2330"
        android:textSize="17sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/scratch_footer"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/scratch_bottom_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/scratch_plain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="Plain text · UTF-8"
            android:textColor="#FF7A849A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/scratch_write"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/scratch_btn_primary"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Write"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
