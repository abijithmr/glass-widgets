<?xml version="1.0" encoding="utf-8"?>
<!-- System monitor, look D: thermal dashboard -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:letterSpacing="0.1"
                    android:text="SYSTEM MONITOR"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                android:id="@+id/md_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="CPU"
                    android:textColor="#FFB08F"
                    android:textSize="9sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                <TextView
                android:id="@+id/md_cpu_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-light"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp" />

                <TextView
                android:id="@+id/md_cpu_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="18sp" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/md_cpu_bar"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <TextView
                android:id="@+id/md_cpu_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="BATTERY"
                    android:textColor="#FFDB8F"
                    android:textSize="9sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                <TextView
                android:id="@+id/md_bt_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-light"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp" />

                <TextView
                android:id="@+id/md_bt_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="sans-serif"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="18sp" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/md_bt_bar"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <TextView
                android:id="@+id/md_bt_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="MEMORY"
                    android:textColor="#CDB3FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            <ImageView
                android:id="@+id/md_ram_bar"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

                <TextView
                android:id="@+id/md_ram_val"
                    android:layout_width="98dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="STORAGE"
                    android:textColor="#8FE8E2"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            <ImageView
                android:id="@+id/md_stor_bar"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

                <TextView
                android:id="@+id/md_stor_val"
                    android:layout_width="98dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="CHARGE"
                    android:textColor="#A3E8B5"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            <ImageView
                android:id="@+id/md_chg_bar"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

                <TextView
                android:id="@+id/md_chg_val"
                    android:layout_width="98dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
