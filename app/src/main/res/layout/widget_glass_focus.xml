<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Shortcut circles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <LinearLayout
                    android:id="@+id/focus_alarm"
                    style="@style/GlassFocusCircle"
                    android:background="@drawable/glass_tile">
                    <ImageView
                        style="@style/GlassFocusIcon"
                        android:src="@drawable/ic_alarm" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <LinearLayout
                    android:id="@+id/focus_bell"
                    style="@style/GlassFocusCircle"
                    android:background="@drawable/glass_tile">
                    <ImageView
                        style="@style/GlassFocusIcon"
                        android:src="@drawable/ic_bell" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <LinearLayout
                    android:id="@+id/focus_airplane"
                    style="@style/GlassFocusCircle"
                    android:background="@drawable/glass_tile">
                    <ImageView
                        style="@style/GlassFocusIcon"
                        android:src="@drawable/ic_airplane" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">
                <LinearLayout
                    android:id="@+id/focus_moon"
                    style="@style/GlassFocusCircle"
                    android:background="@drawable/glass_tile">
                    <ImageView
                        android:id="@+id/focus_moon_icon"
                        style="@style/GlassFocusIcon"
                        android:src="@drawable/ic_moon" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:text="Mode"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/focus_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/focus_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:background="#33FFFFFF"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/focus_row_0"
            style="@style/GlassFocusRow" />

        <TextView
            android:id="@+id/focus_row_1"
            style="@style/GlassFocusRow" />

        <TextView
            android:id="@+id/focus_row_2"
            style="@style/GlassFocusRow" />

        <TextView
            android:id="@+id/focus_row_3"
            style="@style/GlassFocusRow" />

    </LinearLayout>

</FrameLayout>
