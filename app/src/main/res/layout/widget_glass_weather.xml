<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left: city, date, temperature -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weather_city"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:format12Hour="EEEE d, MMM yyyy"
                    android:format24Hour="EEEE d, MMM yyyy"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <TextView
                    android:id="@+id/weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="--°C"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

            </LinearLayout>

            <!-- Right: icon, feels like, high and low -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weather_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="🌡️"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/weather_feels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/weather_high"
                        style="@style/GlassChip"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textSize="11sp"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                    <TextView
                        android:id="@+id/weather_low"
                        style="@style/GlassChip"
                        android:layout_marginStart="6dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textSize="11sp"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Week strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:weightSum="7">

            <TextView
                android:id="@+id/day_0"
                style="@style/GlassDay"
                android:text="MON"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/day_1"
                style="@style/GlassDay"
                android:text="TUE"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/day_2"
                style="@style/GlassDay"
                android:text="WED"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/day_3"
                style="@style/GlassDay"
                android:text="THU"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/day_4"
                style="@style/GlassDay"
                android:text="FRI"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/day_5"
                style="@style/GlassDay"
                android:text="SAT"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/day_6"
                style="@style/GlassDay"
                android:text="SUN"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
