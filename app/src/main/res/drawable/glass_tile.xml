<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass for round tiles and pills (a large radius turns a square into a circle) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#1AFFFFFF"
                android:startColor="#40FFFFFF"
                android:type="linear" />
            <corners android:radius="40dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#73FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>

</layer-list>
