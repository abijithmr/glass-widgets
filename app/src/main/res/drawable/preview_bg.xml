<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in wallpaper behind widget previews, so the glass has something to sit on -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#5B9BD9"
        android:endColor="#1F5F6B"
        android:startColor="#2E5FB8"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
