<?xml version="1.0" encoding="utf-8"?>
<!-- Smoked glass for round tiles and pills -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#8C0B0F14"
                android:startColor="#A61B222B"
                android:type="linear" />
            <corners android:radius="40dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.2dp"
                android:color="#40FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>

</layer-list>
