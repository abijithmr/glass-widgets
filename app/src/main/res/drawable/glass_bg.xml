<?xml version="1.0" encoding="utf-8"?>
<!--
  Frosted "glass" tile. Android widgets can't blur what's behind them,
  so the effect is a translucent diagonal gradient, a bright hairline edge,
  and a soft top highlight.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Dark base so white text stays readable on light wallpapers
      (about 5:1 for main text on a light grey wallpaper).
    -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#AD0B0F14" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Body: see-through white tint, a bit stronger at the top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#14FFFFFF"
                android:startColor="#20FFFFFF"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Top highlight, like light catching the glass edge -->
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#10FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
        </shape>
    </item>

    <!-- Thin bright border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#66FFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>

</layer-list>
